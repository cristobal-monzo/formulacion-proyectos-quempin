rules_version = '2';

// Reglas de seguridad de Firestore para la herramienta de Formulación de Proyectos QUEMPIN.
// Se copian en Firebase → Firestore Database → Reglas → Publicar (ver docs/FIREBASE.md).
//
// Solo entran los correos que estén en la colección "usuarios" (el id del documento es el
// correo en minúsculas). Rol "admin": administra usuarios, la configuración de la empresa y
// elimina definitivamente. Rol "editor": crea, edita y envía proyectos a la papelera.

service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function correo() {
      return request.auth.token.email.lower();
    }
    function miembro() {
      return conSesion() && exists(/databases/$(database)/documents/usuarios/$(correo()));
    }
    function admin() {
      return miembro() && get(/databases/$(database)/documents/usuarios/$(correo())).data.rol == 'admin';
    }

    match /usuarios/{email} {
      allow read: if miembro() || (conSesion() && email == correo());
      allow write: if admin();
    }

    match /proyectos/{id} {
      function valido() {
        let d = request.resource.data;
        return d.uid == id
          && d.modificadoPor == correo()
          && d.datos is string
          && d.datos.size() < 1000000
          && (!('purgado' in d) || admin());
      }
      allow read: if miembro();
      allow create: if miembro() && valido();
      allow update: if miembro() && valido() && (!('purgado' in resource.data) || admin());
      allow delete: if admin();
    }

    match /config/{doc} {
      allow read: if miembro();
      allow write: if admin();
    }
  }
}
